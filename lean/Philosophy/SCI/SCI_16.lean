/-
SCI-16 · From Correlation to Causation
Formalization of Theorem 4.3, Proposition 4.4, Proposition 3.1 (in the
three-variable case) and Propositions 4.5 to 4.7 (three Boolean variables).

Variables X, Z, Y. A graph assigns to each of the pairs (X, Z), (Z, Y),
(X, Y) no edge or an edge in one of two directions; all 27 patterns are
admitted, so the results hold a fortiori for the acyclic ones. The
d-separation of X and Y, unconditionally or given Z, is computed by the
three-variable form of Definition 2.3. A joint distribution is given by
natural-number weights on the eight value combinations; (conditional)
independence is stated by cross-multiplication and decided by computation.

The Markov and faithfulness conditions (Assumptions 2.4 and 2.5) are used
only in their restriction to the pair X, Y, which the full conditions
entail. They appear as hypotheses of the theorems, which are therefore
conditional statements about every graph and every distribution.

What this file establishes. Under the two conditions, the independences
between X and Y fix whether X and Y are adjacent, and when they are not,
whether Z is a common effect of X and Y or a cause of one of them
(Theorem 4.3). Chain and fork are not distinguished (Proposition 4.4).
Without faithfulness, no independence data exclude any graph in which X
and Y are adjacent (Proposition 3.1). Concrete distributions realize each
case, and one distribution generated by a complete graph with cancelling
paths is faithful to a collider instead (Propositions 4.5 to 4.7).

What it does not establish. It does not establish that actual causal
systems satisfy the Markov or faithfulness condition, and it does not treat
latent variables or estimation from finite samples.
-/

namespace Philosophy.SCI_16

/-- An edge between two variables, listed in a fixed order (first, second):
absent, first to second, or second to first. -/
inductive Edge
  | none | fwd | bwd
  deriving DecidableEq, Repr

/-- Definition 2.1 (three-variable case). A graph over X, Z, Y. -/
structure G3 where
  xz : Edge   -- fwd: X → Z
  zy : Edge   -- fwd: Z → Y
  xy : Edge   -- fwd: X → Y
  deriving DecidableEq, Repr

/-- Z is a collider on the path X – Z – Y. -/
def isCollider (g : G3) : Bool := g.xz == .fwd && g.zy == .bwd

/-- Definition 2.3 (three-variable case). X and Y are d-separated, given Z
if `cond` is true and unconditionally otherwise. -/
def dsep (g : G3) (cond : Bool) : Bool :=
  if g.xy != .none then false
  else if g.xz != .none && g.zy != .none then
    (if isCollider g then !cond else cond)
  else true

/-- Joint distributions over (X, Z, Y), as weights. -/
abbrev Dist := Bool → Bool → Bool → Nat

def all2 (f : Bool → Bool → Bool) : Bool :=
  f false false && f false true && f true false && f true true

def pXY (d : Dist) (x y : Bool) : Nat := d x false y + d x true y
def pX (d : Dist) (x : Bool) : Nat := pXY d x false + pXY d x true
def pY (d : Dist) (y : Bool) : Nat := pXY d false y + pXY d true y
def tot (d : Dist) : Nat := pX d false + pX d true
def pXZ (d : Dist) (x z : Bool) : Nat := d x z false + d x z true
def pZY (d : Dist) (z y : Bool) : Nat := d false z y + d true z y
def pZ (d : Dist) (z : Bool) : Nat := pXZ d false z + pXZ d true z

/-- X and Y are independent. -/
def indep (d : Dist) : Bool :=
  all2 fun x y => pXY d x y * tot d == pX d x * pY d y

/-- X and Y are independent conditional on Z. -/
def condIndep (d : Dist) : Bool :=
  all2 fun x y =>
    (d x false y * pZ d false == pXZ d x false * pZY d false y) &&
    (d x true y * pZ d true == pXZ d x true * pZY d true y)

/-- Independence of X and Y, given Z if `cond` is true. -/
def indepAt (d : Dist) (cond : Bool) : Bool :=
  if cond then condIndep d else indep d

/-- Assumption 2.4 (Markov condition), restricted to X and Y:
d-separation implies independence. -/
def MarkovXY (g : G3) (d : Dist) : Prop :=
  ∀ c, dsep g c = true → indepAt d c = true

/-- Assumption 2.5 (faithfulness), restricted to X and Y: independence
implies d-separation. -/
def FaithfulXY (g : G3) (d : Dist) : Prop :=
  ∀ c, indepAt d c = true → dsep g c = true

/-- Theorem 4.3 (identification). Under the Markov and faithfulness
conditions: (i) if X and Y are independent but dependent given Z, then
X → Z ← Y and X, Y are not adjacent; (ii) if X and Y are dependent but
independent given Z, they are not adjacent, Z is adjacent to both, and Z
is a direct cause of X or of Y; (iii) if they are dependent both
unconditionally and given Z, they are adjacent. -/
theorem identification (g : G3) (d : Dist)
    (hm : MarkovXY g d) (hf : FaithfulXY g d) :
    (indepAt d false = true → indepAt d true = false →
        g.xz = .fwd ∧ g.zy = .bwd ∧ g.xy = .none) ∧
    (indepAt d false = false → indepAt d true = true →
        g.xy = .none ∧ g.xz ≠ .none ∧ g.zy ≠ .none ∧
        (g.xz = .bwd ∨ g.zy = .fwd)) ∧
    (indepAt d false = false → indepAt d true = false → g.xy ≠ .none) := by
  have e : ∀ c, dsep g c = indepAt d c := by
    intro c
    cases h : indepAt d c
    · cases h' : dsep g c
      · rfl
      · have := hm c h'; rw [h] at this; exact this.symm
    · exact hf c h
  have e0 := e false
  have e1 := e true
  generalize indepAt d false = b0 at e0 ⊢
  generalize indepAt d true = b1 at e1 ⊢
  obtain ⟨xz, zy, xy⟩ := g
  cases xz <;> cases zy <;> cases xy <;> cases b0 <;> cases b1 <;>
    simp_all [dsep, isCollider]

/-- Proposition 4.4 (Markov equivalence of chain and fork). The chain
X → Z → Y and the fork X ← Z → Y have the same d-separations, so no
distribution distinguishes them under the two conditions. -/
theorem chain_fork (c : Bool) :
    dsep ⟨.fwd, .fwd, .none⟩ c = dsep ⟨.bwd, .fwd, .none⟩ c := by
  cases c <;> rfl

/-- Proposition 3.1, three-variable case (Markov alone is silent). Every
distribution satisfies the Markov condition for every graph in which X and
Y are adjacent. -/
theorem markov_alone (d : Dist) (g : G3) (h : g.xy ≠ .none) :
    MarkovXY g d := by
  intro c hc
  obtain ⟨xz, zy, xy⟩ := g
  cases xy
  · exact absurd rfl h
  all_goals simp [dsep] at hc

/-- Proposition 4.5. A noisy chain: X fair, Z copies X with probability 3/4,
Y copies Z with probability 3/4 (weights in 32nds). -/
def chainDist : Dist := fun x z y =>
  (if x == z then 3 else 1) * (if z == y then 3 else 1)

theorem chain_example :
    MarkovXY ⟨.fwd, .fwd, .none⟩ chainDist ∧
    FaithfulXY ⟨.fwd, .fwd, .none⟩ chainDist ∧
    MarkovXY ⟨.bwd, .fwd, .none⟩ chainDist ∧
    FaithfulXY ⟨.bwd, .fwd, .none⟩ chainDist := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> intro c <;> cases c <;> decide

/-- Proposition 4.6. A collider: X and Y fair and independent, Z = X or Y. -/
def colliderDist : Dist := fun x z y => if z == (x || y) then 1 else 0

theorem collider_example :
    MarkovXY ⟨.fwd, .bwd, .none⟩ colliderDist ∧
    FaithfulXY ⟨.fwd, .bwd, .none⟩ colliderDist := by
  refine ⟨?_, ?_⟩ <;> intro c <;> cases c <;> decide

/-- Proposition 4.7 (cancellation). Z := X xor U and Y := X xor Z, so that Y = U.
The generating graph X → Z → Y, X → Y is complete; the distribution
satisfies the Markov condition for it but not faithfulness, and is
faithful to the collider X → Z ← Y. -/
def xorDist : Dist := fun x z y => if z == (x ^^ y) then 1 else 0

theorem xor_example :
    MarkovXY ⟨.fwd, .fwd, .fwd⟩ xorDist ∧
    ¬ FaithfulXY ⟨.fwd, .fwd, .fwd⟩ xorDist ∧
    MarkovXY ⟨.fwd, .bwd, .none⟩ xorDist ∧
    FaithfulXY ⟨.fwd, .bwd, .none⟩ xorDist := by
  refine ⟨markov_alone _ _ (by decide), ?_, ?_, ?_⟩
  · intro h; exact absurd (h false (by decide)) (by decide)
  all_goals intro c; cases c <;> decide

end Philosophy.SCI_16

#print axioms Philosophy.SCI_16.identification
#print axioms Philosophy.SCI_16.xor_example
