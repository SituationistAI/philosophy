/-
SCI-12 · Bayesian Confirmation and Old Evidence
Formalization of Lemma 3.1, Theorems 3.3 and 3.4 and Propositions 3.5
and 3.7.

A credence function over the four cells generated by a hypothesis H and an
evidence proposition E is represented by four natural-number weights
(H and E, H and not-E, not-H and E, not-H and not-E). Probabilities are
ratios of weights, and inequalities between ratios are stated by
cross-multiplication, so the development is arithmetic in Nat.

An agent's situation with respect to H and an item E of her evidence is
given by her counterfactual credence: the rational credence for her
evidence base with E removed (Definition 2.4). Her actual credence is that
credence conditioned on E (Assumption 2.3, an axiom below). Confirmation is
a primitive relation, tied to the counterfactual credence by Principle P1
(an axiom below).

What this file establishes. Relative to actual credence, old evidence never
confirms (Lemma 3.1). Under P1 and Assumption 2.3, E confirms H iff the
actual credence in H exceeds the counterfactual credence (Theorem 3.3), iff
a product condition on the counterfactual weights holds (Theorem 3.4); in
the Mercury model E confirms H although its actual probability is 1
(Proposition 3.5); evidence already certain on the rest of the base
confirms nothing (Proposition 3.7).

What it does not establish. It does not establish Principle P1, the
uniqueness of rational credence (Assumption 2.2), or that the numbers of
the Mercury model are the right ones.
-/

namespace Philosophy.SCI_12

/-- A credence function over the four cells, as unnormalized weights. -/
structure Cred where
  hE : Nat   -- H and E
  hN : Nat   -- H and not-E
  nE : Nat   -- not-H and E
  nN : Nat   -- not-H and not-E

/-- Total weight. -/
def Cred.total (c : Cred) : Nat := c.hE + c.hN + c.nE + c.nN

/-- Incremental confirmation relative to a credence function c
(Section 1): c(H | E) > c(H), that is,
(hE + hN) / total < hE / (hE + nE), cross-multiplied. -/
def IncConfirms (c : Cred) : Prop :=
  (c.hE + c.hN) * (c.hE + c.nE) < c.hE * c.total

/-- Conditioning on E: the not-E cells receive weight 0. -/
def condE (c : Cred) : Cred := ⟨c.hE, 0, c.nE, 0⟩

/-- E is certain for c: the not-E cells have weight 0. -/
def Certain (c : Cred) : Prop := c.hN = 0 ∧ c.nN = 0

/-- `Higher c d`: the probability of H on d exceeds that on c,
cross-multiplied. -/
def Higher (c d : Cred) : Prop :=
  (c.hE + c.hN) * d.total < (d.hE + d.hN) * c.total

/-- An agent's situation with respect to H and an item E of her evidence
base. -/
axiom Situation : Type

/-- Definition 2.4. The counterfactual credence: the rational credence for
the agent's evidence base with E removed (unique by Assumption 2.2). -/
axiom cf : Situation → Cred

/-- The agent's actual credence. -/
axiom actual : Situation → Cred

/-- Assumption 2.3 (conditionalization). The actual credence is the
counterfactual credence conditioned on E. -/
axiom assumption_2_3 : ∀ s, actual s = condE (cf s)

/-- `Confirms s`: in situation s, E confirms H. -/
axiom Confirms : Situation → Prop

/-- Principle P1 (counterfactual Bayesian confirmation). E confirms H iff
E raises the probability of H on the counterfactual credence. -/
axiom principle_P1 : ∀ s, Confirms s ↔ IncConfirms (cf s)

/-- Lemma 3.1 (Glymour). On a credence function for which E is certain,
E does not confirm H. -/
theorem glymour (c : Cred) (h : Certain c) : ¬ IncConfirms c := by
  obtain ⟨h1, h2⟩ := h
  simp only [IncConfirms, Cred.total, h1, h2, Nat.add_zero]
  exact Nat.lt_irrefl _

/-- Lemma 3.1, applied: old evidence never confirms relative to actual
credence, since E is certain on it. -/
theorem actual_never_confirms (s : Situation) :
    Certain (actual s) ∧ ¬ IncConfirms (actual s) := by
  have hc : Certain (actual s) := by
    rw [assumption_2_3]; exact ⟨rfl, rfl⟩
  exact ⟨hc, glymour _ hc⟩

/-- The criterion of P1 as a product condition on the four weights. -/
theorem inc_iff (c : Cred) : IncConfirms c ↔ c.hN * c.nE < c.hE * c.nN := by
  simp only [IncConfirms, Cred.total, Nat.add_mul, Nat.mul_add]
  rw [Nat.mul_comm c.hN c.hE]
  omega

/-- Theorem 3.3 (difference form). E confirms H iff the actual credence in
H exceeds the counterfactual credence in H. -/
theorem confirms_iff_raises (s : Situation) :
    Confirms s ↔ Higher (cf s) (actual s) := by
  rw [principle_P1, assumption_2_3]
  simp only [IncConfirms, Higher, condE, Cred.total, Nat.add_zero]

/-- Theorem 3.4 (four-cell criterion). E confirms H iff, on the
counterfactual credence, c(H ∧ ¬E) c(¬H ∧ E) < c(H ∧ E) c(¬H ∧ ¬E). -/
theorem confirms_iff_product (s : Situation) :
    Confirms s ↔ (cf s).hN * (cf s).nE < (cf s).hE * (cf s).nN := by
  rw [principle_P1, inc_iff]

/-- The Mercury model of Proposition 3.5: prior 0.3 for general relativity,
likelihood 0.9 on H and 0.1 on not-H, in hundredths. -/
def mercury : Cred := ⟨27, 3, 7, 63⟩

/-- Proposition 3.5 (Mercury). If the counterfactual credence is the
Mercury model, then the perihelion confirms general relativity, although
its actual probability is 1 and it does not raise the actual probability
of the theory. -/
theorem mercury_confirms (s : Situation) (h : cf s = mercury) :
    Confirms s ∧ Certain (actual s) ∧ ¬ IncConfirms (actual s) := by
  refine ⟨?_, actual_never_confirms s⟩
  rw [confirms_iff_product, h]
  decide

/-- Proposition 3.7 (redundancy). If E is already certain on the
counterfactual credence, E does not confirm H. -/
theorem redundant (s : Situation) (h : Certain (cf s)) : ¬ Confirms s := by
  rw [principle_P1]; exact glymour _ h

end Philosophy.SCI_12

#print axioms Philosophy.SCI_12.glymour
#print axioms Philosophy.SCI_12.confirms_iff_product
#print axioms Philosophy.SCI_12.mercury_confirms
