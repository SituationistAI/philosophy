/-
EPI-05 · The Structure of Justification
Formalization of Lemmas 4.1 and 4.2, Theorems 4.3, 4.4 and 4.7, Corollaries
4.5 and 4.6, and Proposition 4.8.

Beliefs and experiences are distinct primitive types: experiences ground
beliefs but are not themselves candidates for justification. Justification
is generated by undefeated experiential grounding (Assumption 3.4, from
EPI-19) and transmitted by good inference from justified premises
(Assumption 3.5), and has no other source (Assumption 3.6).

What this file establishes. A belief is justified exactly when it has a
support tree of finite height whose leaves are undefeated experientially
grounded beliefs and whose internal nodes are undefeated good inferences
(Theorem 4.3). No set of beliefs that is closed under support and contains no
experientially grounded belief contains a justified belief (Theorem 4.4); in
particular, no circle of mutually supporting beliefs (Corollary 4.5) and no
infinite regress of reasons (Corollary 4.6) generates justification. Given
that no empirical belief is inferred from no premises (Assumption 3.7),
every justified belief derives from some experience (Theorem 4.7). A
two-belief model shows that coherentist closure counts an isolated circle as
justified, while the generated notion does not (Proposition 4.8).

What it does not establish. Which inferences are good, which states defeat,
or that the experiential sufficiency premise is true; these are the business
of EPI-03 and EPI-19. Nor anything about a priori justification.
-/

namespace Philosophy.EPI_05

/-- Beliefs: the candidates for justification. -/
axiom Belief : Type
/-- Experiences: states that ground beliefs and are not themselves justified
or unjustified. -/
axiom Experience : Type

/-- Definition 3.1 (experiential grounding). `Grounds e b`: the belief `b` is
held on the basis of the experience `e`, in which it seems to the subject
that the content of `b` is true. -/
axiom Grounds : Experience → Belief → Prop
/-- Definition 3.2 (good inference). `Infers ps b`: the belief `b` is held by
a good inference from the premise beliefs `ps`. -/
axiom Infers : List Belief → Belief → Prop
/-- Definition 3.3 (defeat). `Defeated b`: the subject has a defeater for `b`. -/
axiom Defeated : Belief → Prop
/-- `Justified b`: the belief `b` is justified. -/
axiom Justified : Belief → Prop

/-- Assumption 3.4 (experiential sufficiency, EPI-19). -/
axiom experiential :
  ∀ e b, Grounds e b → ¬ Defeated b → Justified b

/-- Assumption 3.5 (transmission). -/
axiom transmission :
  ∀ ps b, Infers ps b → (∀ p, p ∈ ps → Justified p) → ¬ Defeated b → Justified b

/-- Assumption 3.6 (no other source). Justification is had only through the
two sources of Assumptions 3.4 and 3.5: any property of beliefs that both
sources confer belongs to every justified belief. -/
axiom no_other_source :
  ∀ P : Belief → Prop,
    (∀ e b, Grounds e b → ¬ Defeated b → P b) →
    (∀ ps b, Infers ps b → (∀ p, p ∈ ps → P p) → ¬ Defeated b → P b) →
    ∀ b, Justified b → P b

/-- Assumption 3.7 (empirical premises). No empirical belief is held by
inference from no premises. -/
axiom premises_nonempty : ∀ b, ¬ Infers [] b

/-- Definition 3.8 (support tree). `Tree n b`: `b` has a support tree of
height at most `n`, whose leaves are undefeated experientially grounded
beliefs and whose internal nodes are undefeated good inferences. -/
inductive Tree : Nat → Belief → Prop
  | root {n : Nat} (e : Experience) (b : Belief) :
      Grounds e b → ¬ Defeated b → Tree n b
  | node {n : Nat} (ps : List Belief) (b : Belief) :
      Infers ps b → (∀ p, p ∈ ps → Tree n p) → ¬ Defeated b → Tree (n + 1) b

/-- Lemma 4.1 (monotonicity), one step. -/
theorem Tree.succ {n : Nat} {b : Belief} (h : Tree n b) : Tree (n + 1) b := by
  induction h with
  | root e b hg hd => exact Tree.root e b hg hd
  | node ps b hi _ hd ih => exact Tree.node ps b hi ih hd

/-- Lemma 4.1 (monotonicity). A tree of height at most `n` is a tree of
height at most `n + k`. -/
theorem Tree.mono {n : Nat} {b : Belief} (h : Tree n b) : ∀ k, Tree (n + k) b
  | 0 => h
  | k + 1 => (Tree.mono h k).succ

/-- Lemma 4.2 (common bound). Finitely many premises with trees have trees of
a common height. -/
theorem common_bound :
    ∀ ps : List Belief, (∀ p, p ∈ ps → ∃ n, Tree n p) → ∃ N, ∀ p, p ∈ ps → Tree N p
  | [], _ => ⟨0, fun _ h => nomatch h⟩
  | q :: qs, h => by
    obtain ⟨n, hn⟩ := h q (List.Mem.head qs)
    obtain ⟨N, hN⟩ := common_bound qs (fun p hp => h p (List.Mem.tail q hp))
    refine ⟨n + N, fun p hp => ?_⟩
    cases hp with
    | head => exact hn.mono N
    | tail _ hp' =>
      have := (hN p hp').mono n
      rw [Nat.add_comm] at this
      exact this

/-- Every belief with a support tree is justified. -/
theorem tree_sound {n : Nat} {b : Belief} (h : Tree n b) : Justified b := by
  induction h with
  | root e b hg hd => exact experiential e b hg hd
  | node ps b hi _ hd ih => exact transmission ps b hi ih hd

/-- Theorem 4.3 (tree theorem). A belief is justified if and only if it has a
support tree of finite height. -/
theorem tree_theorem (b : Belief) : Justified b ↔ ∃ n, Tree n b := by
  constructor
  · intro hj
    refine no_other_source (fun b => ∃ n, Tree n b) ?_ ?_ b hj
    · intro e b hg hd
      exact ⟨0, Tree.root e b hg hd⟩
    · intro ps b hi hp hd
      obtain ⟨N, hN⟩ := common_bound ps hp
      exact ⟨N + 1, Tree.node ps b hi hN hd⟩
  · intro ⟨_, h⟩
    exact tree_sound h

/-- Theorem 4.4 (no rootless justification). If a set of beliefs contains no
experientially grounded belief, and every good inference to a member has a
premise in the set, no member is justified. -/
theorem no_rootless (S : Belief → Prop)
    (hg : ∀ e b, S b → ¬ Grounds e b)
    (hi : ∀ ps b, S b → Infers ps b → ∃ p, p ∈ ps ∧ S p) :
    ∀ b, S b → ¬ Justified b := by
  intro b hb hj
  have key : ∀ b, Justified b → ¬ S b :=
    no_other_source (fun b => ¬ S b)
      (fun e b hgr _ hs => hg e b hs hgr)
      (fun ps b hinf hp _ hs => by
        obtain ⟨p, hmem, hsp⟩ := hi ps b hs hinf
        exact hp p hmem hsp)
  exact key b hj hb

/-- Corollary 4.5 (circles). A finite circle of beliefs, none experientially
grounded, each of whose good inferences has a premise in the circle,
contains no justified belief. -/
theorem no_circle (circle : List Belief)
    (hg : ∀ e b, b ∈ circle → ¬ Grounds e b)
    (hi : ∀ ps b, b ∈ circle → Infers ps b → ∃ p, p ∈ ps ∧ p ∈ circle) :
    ∀ b, b ∈ circle → ¬ Justified b :=
  no_rootless (fun b => b ∈ circle) hg hi

/-- Corollary 4.6 (regresses). An infinite chain of reasons, none
experientially grounded, each of whose good inferences has a premise in the
chain, contains no justified belief. -/
theorem no_regress (chain : Nat → Belief)
    (hg : ∀ n e, ¬ Grounds e (chain n))
    (hi : ∀ n ps, Infers ps (chain n) → ∃ m, chain m ∈ ps) :
    ∀ n, ¬ Justified (chain n) := by
  intro n
  apply no_rootless (fun b => ∃ m, b = chain m) _ _ (chain n) ⟨n, rfl⟩
  · intro e b ⟨m, hm⟩ hgr
    exact hg m e (hm ▸ hgr)
  · intro ps b ⟨m, hm⟩ hinf
    obtain ⟨k, hk⟩ := hi m ps (hm ▸ hinf)
    exact ⟨chain k, hk, k, rfl⟩

/-- Derivation from an experience, used in the statement of Theorem 4.7. -/
inductive DerivesFrom : Belief → Experience → Prop
  | base (e : Experience) (b : Belief) : Grounds e b → DerivesFrom b e
  | step (e : Experience) (ps : List Belief) (b p : Belief) :
      Infers ps b → p ∈ ps → DerivesFrom p e → DerivesFrom b e

/-- Theorem 4.7 (experiential dependence). Every justified belief derives,
through a finite chain of good inferences, from some experience. -/
theorem experiential_dependence (b : Belief) (hj : Justified b) :
    ∃ e, DerivesFrom b e := by
  refine no_other_source (fun b => ∃ e, DerivesFrom b e) ?_ ?_ b hj
  · intro e b hg _
    exact ⟨e, DerivesFrom.base e b hg⟩
  · intro ps b hi hp _
    cases ps with
    | nil => exact absurd hi (premises_nonempty b)
    | cons q qs =>
      obtain ⟨e, he⟩ := hp q (List.Mem.head qs)
      exact ⟨e, DerivesFrom.step e (q :: qs) b q hi (List.Mem.head qs) he⟩

/- Proposition 4.8 (the isolation model). Two beliefs, each inferred from
the other, neither grounded in experience. -/
namespace Isolation

/-- The model's grounding relation: nothing is grounded. -/
def G (_ : Unit) (_ : Bool) : Prop := False
/-- The model's inference relation: each belief is inferred from the other. -/
def I (ps : List Bool) (b : Bool) : Prop := ps = [!b]

/-- Justification generated from grounding by inference (no defeat). -/
inductive Gen : Bool → Prop
  | root (e : Unit) (b : Bool) : G e b → Gen b
  | node (ps : List Bool) (b : Bool) : I ps b → (∀ p, p ∈ ps → Gen p) → Gen b

/-- Proposition 4.8 (i). Coherentist closure: every belief is supported by
members of the system. -/
theorem coherent : ∀ b : Bool, ∃ ps, I ps b ∧ ∀ p, p ∈ ps → True :=
  fun b => ⟨[!b], rfl, fun _ _ => trivial⟩

/-- Proposition 4.8 (ii). No belief of the system is generated. -/
theorem not_generated : ∀ b : Bool, ¬ Gen b := by
  intro b h
  induction h with
  | root e b hg => exact hg
  | node ps b hi _ ih =>
    exact ih (!b) (by rw [hi]; exact List.Mem.head [])

end Isolation

end Philosophy.EPI_05

#print axioms Philosophy.EPI_05.tree_theorem
#print axioms Philosophy.EPI_05.no_rootless
#print axioms Philosophy.EPI_05.experiential_dependence
#print axioms Philosophy.EPI_05.Isolation.not_generated
